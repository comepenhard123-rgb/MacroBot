"""
Elliot Strategy Analyzer
Analyse macro + price action sur 8 assets et envoie un rapport Telegram
si un setup des 6 étapes est détecté.
"""

import os
import requests
import json
from datetime import datetime, timezone
import time

# ─────────────────────────────────────────────
# CONFIG — à remplir dans les variables d'env
# ─────────────────────────────────────────────
TELEGRAM_TOKEN = os.environ.get("TELEGRAM_TOKEN", "")
TELEGRAM_CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID", "")
ALPHAVANTAGE_KEY = os.environ.get("ALPHAVANTAGE_KEY", "demo")  # gratuit sur alphavantage.co
NEWSAPI_KEY = os.environ.get("NEWSAPI_KEY", "")  # gratuit sur newsapi.org

# Assets à surveiller
ASSETS = {
    "FX_MAJOR": ["EURUSD", "GBPUSD", "USDJPY"],
    "FX_MINOR": ["EURCHF", "GBPJPY", "AUDUSD"],
    "COMMODITIES": ["XAUUSD"],
    "INDICES": ["SPX", "NDX"],
}

# Seuils de scoring (sur 100)
SCORE_THRESHOLD = 60  # Score minimum pour envoyer une alerte

# ─────────────────────────────────────────────
# STEP 1 — ANALYSE MACRO
# ─────────────────────────────────────────────

def get_macro_context():
    """
    Récupère les données macro via NewsAPI + indicateurs économiques publics.
    Retourne un score macro et un résumé.
    """
    macro_signals = []
    score = 0

    # Récupération des news macro
    if NEWSAPI_KEY:
        try:
            url = f"https://newsapi.org/v2/everything?q=fed+interest+rate+inflation+gdp&sortBy=publishedAt&language=en&pageSize=5&apiKey={NEWSAPI_KEY}"
            resp = requests.get(url, timeout=10)
            articles = resp.json().get("articles", [])
            
            # Analyse basique des titres pour détecter le sentiment
            hawkish_words = ["hike", "hawkish", "inflation", "tight", "restrictive"]
            dovish_words = ["cut", "dovish", "recession", "slowdown", "easing", "pause"]
            
            hawkish_count = 0
            dovish_count = 0
            
            for article in articles:
                title = (article.get("title") or "").lower()
                for w in hawkish_words:
                    if w in title: hawkish_count += 1
                for w in dovish_words:
                    if w in title: dovish_count += 1
            
            if hawkish_count > dovish_count:
                macro_signals.append(f"📰 Sentiment macro HAWKISH détecté ({hawkish_count} signaux)")
                score += 15
            elif dovish_count > hawkish_count:
                macro_signals.append(f"📰 Sentiment macro DOVISH détecté ({dovish_count} signaux)")
                score += 15
            else:
                macro_signals.append("📰 Sentiment macro NEUTRE")
                score += 5

        except Exception as e:
            macro_signals.append(f"⚠️ News non disponibles ({e})")

    # Calendrier économique simplifié (jours à forts impacts)
    now = datetime.now(timezone.utc)
    day_of_week = now.weekday()  # 0=Lun, 4=Ven
    hour = now.hour

    # Vendredi 13h-15h UTC = souvent NFP ou données importantes
    if day_of_week == 4 and 13 <= hour <= 15:
        macro_signals.append("⚡ ATTENTION : Possible publication NFP / données US importantes (Vendredi 13-15h UTC)")
        score += 20

    # Mercredi = souvent FOMC / inventaires pétrole
    if day_of_week == 2:
        macro_signals.append("📅 Mercredi : Possible FOMC minutes ou données Fed")
        score += 10

    return score, macro_signals


# ─────────────────────────────────────────────
# STEP 2 — PRICE ACTION & STRUCTURE
# ─────────────────────────────────────────────

def get_price_data(symbol: str) -> dict | None:
    """
    Récupère les données OHLCV via AlphaVantage (gratuit).
    Retourne les dernières bougies daily.
    """
    try:
        # Mapping symboles → AlphaVantage format
        av_map = {
            "EURUSD": ("FX_DAILY", "EUR", "USD"),
            "GBPUSD": ("FX_DAILY", "GBP", "USD"),
            "USDJPY": ("FX_DAILY", "USD", "JPY"),
            "EURCHF": ("FX_DAILY", "EUR", "CHF"),
            "GBPJPY": ("FX_DAILY", "GBP", "JPY"),
            "AUDUSD": ("FX_DAILY", "AUD", "USD"),
            "XAUUSD": ("COMMODITY", None, None),
            "SPX": ("INDEX", None, None),
            "NDX": ("INDEX", None, None),
        }

        if symbol not in av_map:
            return None

        asset_type, from_sym, to_sym = av_map[symbol]

        if asset_type == "FX_DAILY":
            url = (
                f"https://www.alphavantage.co/query"
                f"?function=FX_DAILY&from_symbol={from_sym}&to_symbol={to_sym}"
                f"&outputsize=compact&apikey={ALPHAVANTAGE_KEY}"
            )
            resp = requests.get(url, timeout=15)
            data = resp.json()
            ts_key = "Time Series FX (Daily)"
            if ts_key not in data:
                return None
            ts = data[ts_key]

        elif asset_type == "COMMODITY" and symbol == "XAUUSD":
            url = (
                f"https://www.alphavantage.co/query"
                f"?function=TIME_SERIES_DAILY&symbol=GLD"
                f"&outputsize=compact&apikey={ALPHAVANTAGE_KEY}"
            )
            resp = requests.get(url, timeout=15)
            data = resp.json()
            ts_key = "Time Series (Daily)"
            if ts_key not in data:
                return None
            ts = data[ts_key]

        else:
            # Indices : on utilise SPY pour S&P, QQQ pour Nasdaq
            etf_map = {"SPX": "SPY", "NDX": "QQQ"}
            etf = etf_map.get(symbol, "SPY")
            url = (
                f"https://www.alphavantage.co/query"
                f"?function=TIME_SERIES_DAILY&symbol={etf}"
                f"&outputsize=compact&apikey={ALPHAVANTAGE_KEY}"
            )
            resp = requests.get(url, timeout=15)
            data = resp.json()
            ts_key = "Time Series (Daily)"
            if ts_key not in data:
                return None
            ts = data[ts_key]

        # Extraire les 20 dernières bougies
        dates = sorted(ts.keys(), reverse=True)[:20]
        candles = []
        for d in dates:
            c = ts[d]
            candles.append({
                "date": d,
                "open": float(c.get("1. open", c.get("open", 0))),
                "high": float(c.get("2. high", c.get("high", 0))),
                "low": float(c.get("3. low", c.get("low", 0))),
                "close": float(c.get("4. close", c.get("close", 0))),
            })

        return {"symbol": symbol, "candles": candles}

    except Exception as e:
        print(f"[{symbol}] Erreur fetch prix: {e}")
        return None


def analyze_price_action(price_data: dict) -> dict:
    """
    Analyse technique basée sur la méthode d'Elliot :
    - Tendance (structure de marché)
    - Niveaux clés
    - Momentum / divergence
    Retourne un score et des signaux détectés.
    """
    candles = price_data["candles"]
    if len(candles) < 10:
        return {"score": 0, "signals": ["⚠️ Données insuffisantes"], "direction": "NEUTRE"}

    closes = [c["close"] for c in candles]
    highs = [c["high"] for c in candles]
    lows = [c["low"] for c in candles]

    score = 0
    signals = []
    direction = "NEUTRE"

    # ── Tendance : Higher Highs / Lower Lows ──
    recent_highs = highs[:5]
    older_highs = highs[5:10]
    recent_lows = lows[:5]
    older_lows = lows[5:10]

    if min(recent_highs) > max(older_highs) and min(recent_lows) > max(older_lows):
        signals.append("📈 Tendance HAUSSIÈRE confirmée (HH + HL)")
        score += 20
        direction = "BUY"
    elif max(recent_lows) < min(older_lows) and max(recent_highs) < min(older_highs):
        signals.append("📉 Tendance BAISSIÈRE confirmée (LH + LL)")
        score += 20
        direction = "SELL"
    else:
        signals.append("↔️ Structure de marché RANGE / indécise")
        score += 5

    # ── Momentum : 5 EMA vs 20 EMA (approx) ──
    ema5 = sum(closes[:5]) / 5
    ema20 = sum(closes[:20]) / 20

    if direction == "BUY" and ema5 > ema20:
        signals.append(f"✅ EMA5 ({ema5:.4f}) > EMA20 ({ema20:.4f}) — Momentum haussier confirmé")
        score += 15
    elif direction == "SELL" and ema5 < ema20:
        signals.append(f"✅ EMA5 ({ema5:.4f}) < EMA20 ({ema20:.4f}) — Momentum baissier confirmé")
        score += 15
    else:
        signals.append(f"⚠️ EMA5/EMA20 en conflit avec la tendance")

    # ── Niveau clé : rejet de support/résistance ──
    current = closes[0]
    high_20 = max(highs[:20])
    low_20 = min(lows[:20])
    range_20 = high_20 - low_20

    # Proche d'un support (dans les 1.5% du bas)
    if range_20 > 0 and (current - low_20) / range_20 < 0.15:
        signals.append(f"🔑 Prix proche d'un SUPPORT majeur (bas 20j: {low_20:.4f})")
        score += 20
        if direction != "SELL":
            direction = "BUY"

    # Proche d'une résistance (dans les 1.5% du haut)
    elif range_20 > 0 and (high_20 - current) / range_20 < 0.15:
        signals.append(f"🔑 Prix proche d'une RÉSISTANCE majeure (haut 20j: {high_20:.4f})")
        score += 20
        if direction != "BUY":
            direction = "SELL"

    # ── Bougie de rejet (longue mèche) ──
    last_candle = candles[0]
    body = abs(last_candle["close"] - last_candle["open"])
    total_range = last_candle["high"] - last_candle["low"]
    if total_range > 0 and body / total_range < 0.35:
        signals.append("🕯️ Bougie de rejet détectée (longue mèche / doji)")
        score += 10

    # ── R/R estimé ──
    if direction == "BUY":
        stop_dist = current - low_20
        target_dist = high_20 - current
    else:
        stop_dist = high_20 - current
        target_dist = current - low_20

    if stop_dist > 0:
        rr = target_dist / stop_dist
        if rr >= 2:
            signals.append(f"💰 R/R estimé : {rr:.1f}:1 ✅ (objectif: {high_20 if direction=='BUY' else low_20:.4f})")
            score += 15
        elif rr >= 1:
            signals.append(f"⚠️ R/R estimé : {rr:.1f}:1 (limite acceptable)")
            score += 5
        else:
            signals.append(f"❌ R/R estimé : {rr:.1f}:1 (insuffisant)")

    return {"score": score, "signals": signals, "direction": direction, "current_price": closes[0]}


# ─────────────────────────────────────────────
# STEP 4 — POSITIONNEMENT RETAIL (simulé)
# ─────────────────────────────────────────────

def get_retail_positioning(symbol: str, direction: str) -> dict:
    """
    Dans une version pro, on appellerait Prime Market Terminal ou Oanda sentiment.
    Ici on utilise l'API gratuite Oanda Order Book si disponible,
    sinon on retourne un signal neutre.
    """
    signals = []
    score = 0

    try:
        # Oanda fournit le sentiment retail gratuitement pour certaines paires FX
        oanda_pairs = {
            "EURUSD": "EUR_USD",
            "GBPUSD": "GBP_USD",
            "USDJPY": "USD_JPY",
            "AUDUSD": "AUD_USD",
        }

        if symbol in oanda_pairs:
            pair = oanda_pairs[symbol]
            url = f"https://www.oanda.com/cfds-trading/sentiment/{pair}"
            # Note: On simule ici car l'API Oanda sentiment nécessite un compte
            # Dans la vraie version, remplacer par l'appel API réel
            signals.append("ℹ️ Positionnement retail : données Oanda non connectées (à configurer)")
            score += 5
        else:
            signals.append("ℹ️ Positionnement retail non disponible pour cet asset")
            score += 5

    except Exception:
        signals.append("⚠️ Impossible de récupérer le sentiment retail")

    return {"score": score, "signals": signals}


# ─────────────────────────────────────────────
# SCORING GLOBAL & RAPPORT
# ─────────────────────────────────────────────

def build_report(symbol: str, macro_score: int, macro_signals: list,
                 pa: dict, retail: dict) -> dict:
    """
    Agrège tous les scores et construit le rapport final.
    """
    total_score = min(100, macro_score + pa["score"] + retail["score"])

    # Emoji de direction
    dir_emoji = {"BUY": "🟢 ACHAT", "SELL": "🔴 VENTE", "NEUTRE": "⚪ NEUTRE"}
    direction_label = dir_emoji.get(pa["direction"], "⚪ NEUTRE")

    # Qualité du setup
    if total_score >= 80:
        quality = "🔥 SETUP EXCELLENT"
    elif total_score >= 60:
        quality = "✅ SETUP VALIDE"
    elif total_score >= 40:
        quality = "⚠️ SETUP FAIBLE"
    else:
        quality = "❌ PAS DE SETUP"

    report = {
        "symbol": symbol,
        "direction": pa["direction"],
        "direction_label": direction_label,
        "total_score": total_score,
        "quality": quality,
        "current_price": pa.get("current_price", 0),
        "macro_score": macro_score,
        "pa_score": pa["score"],
        "retail_score": retail["score"],
        "macro_signals": macro_signals,
        "pa_signals": pa["signals"],
        "retail_signals": retail["signals"],
        "timestamp": datetime.now(timezone.utc).strftime("%d/%m/%Y %H:%M UTC"),
    }

    return report


def format_telegram_message(report: dict) -> str:
    """
    Formate le rapport en message Telegram lisible.
    """
    lines = [
        f"━━━━━━━━━━━━━━━━━━━━━",
        f"📊 *ELLIOT STRATEGY ALERT*",
        f"━━━━━━━━━━━━━━━━━━━━━",
        f"",
        f"🎯 *Asset :* `{report['symbol']}`",
        f"💹 *Prix actuel :* `{report['current_price']:.4f}`",
        f"📍 *Signal :* {report['direction_label']}",
        f"⭐ *Score :* `{report['total_score']}/100` — {report['quality']}",
        f"",
        f"━━━━ 📊 Scores par étape ━━━━",
        f"🔍 Macro : `{report['macro_score']} pts`",
        f"📈 Price Action : `{report['pa_score']} pts`",
        f"👥 Retail : `{report['retail_score']} pts`",
        f"",
        f"━━━━ 🔍 Étape 1 — Macro ━━━━",
    ]

    for s in report["macro_signals"]:
        lines.append(f"• {s}")

    lines += [
        f"",
        f"━━━━ 📈 Étape 2 — Price Action ━━━━",
    ]
    for s in report["pa_signals"]:
        lines.append(f"• {s}")

    lines += [
        f"",
        f"━━━━ 👥 Étape 4 — Retail ━━━━",
    ]
    for s in report["retail_signals"]:
        lines.append(f"• {s}")

    lines += [
        f"",
        f"━━━━ ⚠️ Rappel checklist ━━━━",
        f"• Vérifier étape 3 (psycho/plan)",
        f"• Définir stop loss AVANT d'entrer",
        f"• Calculer taille de position",
        f"• Planifier trade management",
        f"",
        f"🕐 _{report['timestamp']}_",
        f"━━━━━━━━━━━━━━━━━━━━━",
    ]

    return "\n".join(lines)


# ─────────────────────────────────────────────
# ENVOI TELEGRAM
# ─────────────────────────────────────────────

def send_telegram(message: str) -> bool:
    """
    Envoie un message via le bot Telegram.
    """
    if not TELEGRAM_TOKEN or not TELEGRAM_CHAT_ID:
        print("⚠️ TELEGRAM_TOKEN ou TELEGRAM_CHAT_ID manquant")
        return False

    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {
        "chat_id": TELEGRAM_CHAT_ID,
        "text": message,
        "parse_mode": "Markdown",
    }

    try:
        resp = requests.post(url, json=payload, timeout=10)
        if resp.status_code == 200:
            print("✅ Message Telegram envoyé")
            return True
        else:
            print(f"❌ Erreur Telegram: {resp.status_code} — {resp.text}")
            return False
    except Exception as e:
        print(f"❌ Erreur envoi Telegram: {e}")
        return False


def send_summary_telegram(alerts: list, scanned: int):
    """
    Envoie un résumé si aucune alerte n'a été trouvée.
    """
    now = datetime.now(timezone.utc).strftime("%d/%m/%Y %H:%M UTC")
    if not alerts:
        msg = (
            f"🔍 *ELLIOT STRATEGY — SCAN TERMINÉ*\n"
            f"━━━━━━━━━━━━━━━━━━━━━\n"
            f"✅ {scanned} assets analysés\n"
            f"💤 Aucun setup détecté (score < {SCORE_THRESHOLD}/100)\n"
            f"🕐 _{now}_"
        )
        send_telegram(msg)


# ─────────────────────────────────────────────
# MAIN LOOP
# ─────────────────────────────────────────────

def run_scan():
    """
    Scan complet de tous les assets.
    """
    print(f"\n{'='*50}")
    print(f"🚀 SCAN DÉMARRÉ — {datetime.now(timezone.utc).strftime('%d/%m/%Y %H:%M UTC')}")
    print(f"{'='*50}\n")

    all_symbols = (
        ASSETS["FX_MAJOR"]
        + ASSETS["FX_MINOR"]
        + ASSETS["COMMODITIES"]
        + ASSETS["INDICES"]
    )

    # Étape 1 : Macro (commune à tous les assets)
    print("📊 Analyse macro en cours...")
    macro_score, macro_signals = get_macro_context()
    print(f"   Score macro : {macro_score}/35")

    alerts_sent = []

    for symbol in all_symbols:
        print(f"\n🔍 Analyse {symbol}...")

        # Étape 2 : Price action
        price_data = get_price_data(symbol)
        if not price_data:
            print(f"   ⚠️ Pas de données pour {symbol}")
            continue

        pa = analyze_price_action(price_data)
        print(f"   Score PA : {pa['score']}/80 | Direction : {pa['direction']}")

        # Étape 4 : Retail positioning
        retail = get_retail_positioning(symbol, pa["direction"])

        # Rapport global
        report = build_report(symbol, macro_score, macro_signals, pa, retail)
        print(f"   Score total : {report['total_score']}/100 — {report['quality']}")

        # Alerte si setup détecté
        if report["total_score"] >= SCORE_THRESHOLD and pa["direction"] != "NEUTRE":
            print(f"   🚨 SETUP DÉTECTÉ — Envoi Telegram...")
            msg = format_telegram_message(report)
            if send_telegram(msg):
                alerts_sent.append(symbol)
            time.sleep(1)  # Éviter le rate limit Telegram

    # Résumé si aucune alerte
    send_summary_telegram(alerts_sent, len(all_symbols))

    print(f"\n{'='*50}")
    print(f"✅ SCAN TERMINÉ — {len(alerts_sent)} alerte(s) envoyée(s)")
    print(f"{'='*50}\n")


if __name__ == "__main__":
    run_scan()
